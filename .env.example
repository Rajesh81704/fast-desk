# FastDesk Environment Configuration Template
# Copy this file to .env for local development

# Verify token configured in Meta App Dashboard for webhook verification
WHATSAPP_VERIFY_TOKEN=fastdesk_webhook_secret

# Meta WhatsApp Cloud API System User / Permanent Access Token
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token_here

# Meta Graph API Version (e.g. v21.0)
META_GRAPH_API_VERSION=v21.0
